diff --git a/win_compat/getopt.h b/win_compat/getopt.h
new file mode 100644
--- /dev/null
+++ b/win_compat/getopt.h
@@ -0,0 +1,30 @@
+#ifndef _WIN_COMPAT_GETOPT_H
+#define _WIN_COMPAT_GETOPT_H
+
+#define no_argument        0
+#define required_argument  1
+#define optional_argument  2
+
+struct option {
+  const char *name;
+  int has_arg;
+  int *flag;
+  int val;
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern char *optarg;
+extern int optind, opterr, optopt;
+
+int getopt(int argc, char *const argv[], const char *optstring);
+int getopt_long(int argc, char *const argv[], const char *optstring,
+                const struct option *longopts, int *longindex);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/getopt.c b/src/getopt.c
new file mode 100644
--- /dev/null
+++ b/src/getopt.c
@@ -0,0 +1,83 @@
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include "getopt.h"
+
+char *optarg = NULL;
+int optind = 1;
+int opterr = 1;
+int optopt = '?';
+
+int getopt_long(int argc, char *const argv[], const char *optstring,
+                const struct option *longopts, int *longindex) {
+  if (optind >= argc || argv[optind] == NULL) {
+    return -1;
+  }
+  char *arg = argv[optind];
+  if (arg[0] != '-' || arg[1] == '\0') {
+    return -1;
+  }
+  if (arg[0] == '-' && arg[1] == '-' && arg[2] == '\0') {
+    optind++;
+    return -1;
+  }
+  if (arg[1] == '-') {
+    const char *name = arg + 2;
+    const char *equal = strchr(name, '=');
+    size_t namelen = equal ? (size_t)(equal - name) : strlen(name);
+    for (int i = 0; longopts && longopts[i].name; i++) {
+      if (strncmp(longopts[i].name, name, namelen) == 0 && longopts[i].name[namelen] == '\0') {
+        if (longindex) *longindex = i;
+        if (longopts[i].has_arg == 1) {
+          if (equal) {
+            optarg = (char*)(equal + 1);
+          } else if (optind + 1 < argc) {
+            optind++;
+            optarg = argv[optind];
+          } else {
+            optopt = longopts[i].val;
+            return optstring && optstring[0] == ':' ? ':' : '?';
+          }
+        } else if (longopts[i].has_arg == 2) {
+          optarg = equal ? (char*)(equal + 1) : NULL;
+        } else {
+          if (equal) return '?';
+          optarg = NULL;
+        }
+        optind++;
+        if (longopts[i].flag) {
+          *(longopts[i].flag) = longopts[i].val;
+          return 0;
+        }
+        return longopts[i].val;
+      }
+    }
+    optind++;
+    return '?';
+  } else {
+    char c = arg[1];
+    const char *p = optstring ? strchr(optstring, c) : NULL;
+    if (!p || c == ':') {
+      optopt = c;
+      optind++;
+      return '?';
+    }
+    if (p[1] == ':') {
+      if (arg[2] != '\0') {
+        optarg = arg + 2;
+      } else if (optind + 1 < argc) {
+        optind++;
+        optarg = argv[optind];
+      } else {
+        optopt = c;
+        optind++;
+        return optstring[0] == ':' ? ':' : '?';
+      }
+    } else {
+      optarg = NULL;
+    }
+    optind++;
+    return c;
+  }
+}
+
+int getopt(int argc, char *const argv[], const char *optstring) {
+  return getopt_long(argc, argv, optstring, NULL, NULL);
+}